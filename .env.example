POSTGRES_PASSWORD=replace-with-a-long-random-password
ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
# Production: set both values to a public DNS name that resolves to this server.
# Caddy obtains the trusted HTTPS certificate automatically.
APP_ORIGIN=https://jobs.example.com
JOB_TRACKER_DOMAIN=jobs.example.com
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
WORKER_POLL_SECONDS=60
# Maximum jobs imported from one paginated source during a search (100-20000).
CONNECTOR_MAX_RESULTS=5000
# Cached geocoding for profile locations and hybrid/on-site job locations.
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_DELAY_MS=1000
RUST_LOG=job_tracker_web=info,tower_http=info
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional fallback coverage. Create credentials at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
